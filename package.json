{
  "name": "saanidhya-events",
  "version": "1.0.0",
  "private": true,
  "description": "Saanidhya Events website: NestJS + Prisma + MySQL (Hostinger ready)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "nest start --watch",
    "build": "node scripts/build.js",
    "prisma:generate": "prisma generate",
    "css:build": "node scripts/build-css.js",
    "css:watch": "node scripts/build-css.js watch",
    "db:schema": "node scripts/apply-schema.js",
    "seed": "node dist/scripts/seed.js",
    "create-admin": "node dist/scripts/create-admin.js",
    "regenerate-images": "node dist/scripts/regenerate-images.js",
    "test": "jest --runInBand",
    "healthcheck": "node scripts/healthcheck.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-mariadb": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "image-size": "^2.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.0",
    "nunjucks": "^3.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.13.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@tailwindcss/typography": "0.5.16",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/nunjucks": "^3.2.6",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "supertest": "^7.0.0",
    "tailwindcss": "3.4.17",
    "ts-jest": "^29.2.5",
    "typescript": "~5.7.3"
  }
}
