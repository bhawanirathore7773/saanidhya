# Copy this file to .env for local development only.
# In Hostinger hPanel, configure these variable names through Node.js App > Environment variables.
# Never commit actual production credentials.
NODE_ENV=production
# Public canonical URL, HTTPS, no trailing slash
SITE_URL=https://yourdomain.com

# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# Use the exact database host/name/user provided by Hostinger.
# Percent-encode reserved characters in the USERNAME/PASSWORD segment, not the whole URL.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME

# Set a temporary long secret only while creating first admin at /admin/setup/.
SETUP_KEY=

# Persistent directory outside the release/app directory; must be writable by Node app.
# Replace with the actual absolute path in your hPanel account.
UPLOAD_DIR=/home/your-host-user/saanidhya-uploads

# Optional: private admin path, must end with slash, e.g. manage-random/
ADMIN_URL=admin/

# SMTP settings: follow your mailbox provider's current host/port/TLS configuration.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=info@yourdomain.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Saanidhya Events <info@yourdomain.com>

# Optional WhatsApp Cloud API notifications
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Configure according to your actual reverse-proxy chain.
TRUST_PROXY=1
CLIENT_IP_HEADER=
HSTS_SECONDS=3600
PAGE_CACHE_ENABLED=True
PAGE_CACHE_MAX_ENTRIES=400
DB_CONNECTION_LIMIT=5
LEAD_RATE_LIMIT_PER_HOUR=5
LEAD_ATTEMPTS_PER_HOUR=20
LEAD_DUPLICATE_WINDOW_MINUTES=10
LEAD_NOTIFY_THREADED=True
AVIF_QUALITY=50
AVIF_EFFORT=3
