# Copy this file to .env for local work. On Hostinger, add the same names in hPanel > Node.js > Environment variables.
# Never share this file or commit it.

NODE_ENV=production
# The public address of the website, with https and WITHOUT a trailing slash
SITE_URL=https://yourdomain.com

# A long random secret (60+ characters). Make one at: https://generate-secret.vercel.app/64  or run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# MySQL created in hPanel > Databases. On Hostinger the host is localhost.
# If the password contains special characters like @ : / # ?, replace each with its %-code (for example @ becomes %40).
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
# Only if your host gives a socket path instead of a TCP port:
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# Needed ONCE to create the first admin at /admin/setup/ (any long secret text). You can delete it afterwards.
SETUP_KEY=

# Where uploaded photos are stored. Use a folder OUTSIDE the app folder so a re-upload of the app never erases photos.
# Example on Hostinger:  /home/u123456789/saanidhya-uploads
UPLOAD_DIR=

# Admin address. Change it to something private if you like, e.g. manage-7x2/ (keep the slash at the end).
ADMIN_URL=admin/

# ---- Email for new-enquiry alerts (Hostinger email example) ----
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=info@yourdomain.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Saanidhya Events <info@yourdomain.com>

# ---- Optional ----
# WhatsApp Cloud API alert to the owner (see docs/ADMIN_GUIDE.md)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# How many reverse proxies sit in front of the app (Hostinger: 1). Used to read the visitor's real IP.
TRUST_PROXY=1
# Cloudflare in front? Then: CLIENT_IP_HEADER=cf-connecting-ip
CLIENT_IP_HEADER=
# HTTPS "remember" time in seconds. Start small; raise to 31536000 after a few good days.
HSTS_SECONDS=3600
# Page cache (memory). Leave on.
PAGE_CACHE_ENABLED=True
# Database connections the app may open at once (shared MySQL allows few)
DB_CONNECTION_LIMIT=5
LEAD_RATE_LIMIT_PER_HOUR=5
