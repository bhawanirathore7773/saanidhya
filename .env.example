# Add variable NAMES and private values in hPanel > Node.js App > Environment variables.
# Never commit real credentials or a production .env file.
NODE_ENV=production
SITE_URL=https://yourdomain.com
SECRET_KEY=
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
SETUP_KEY=
UPLOAD_DIR=/home/your-host-user/saanidhya-uploads
ADMIN_URL=admin/

# SMTP; use values supplied by your email provider.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=info@yourdomain.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Saanidhya Events <info@yourdomain.com>

WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

TRUST_PROXY=1
CLIENT_IP_HEADER=
HSTS_SECONDS=3600
PAGE_CACHE_ENABLED=True
PAGE_CACHE_MAX_ENTRIES=400
DB_CONNECTION_LIMIT=5
LEAD_RATE_LIMIT_PER_HOUR=5
